# Talent Scout server — copy to .env and fill in real values.
# Never commit .env. See docs/TECH-STACK.md §5.

PORT=8080
APP_ENV=development

# Supabase (session pooler for DATABASE_URL)
DATABASE_URL=postgresql://postgres.<project_ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
SUPABASE_URL=https://<project_ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=cvs

# Public URLs / CORS (SSE origins only; comma-separated, no wildcard)
PUBLIC_APP_URL=http://localhost:5173
FRONTEND_ORIGIN=http://localhost:5173,https://talentscout.vercel.app

# Shared with the SvelteKit BFF (same value on client). Generate: openssl rand -base64 32
BFF_SHARED_SECRET=

# Recruiter auth
RECRUITER_PASSWORD=
AUTH_TOKEN_SECRET=

# LLM (fake = deterministic, no network — for tests)
LLM_MODE=fake
LLM_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
MODELS_CONFIG_PATH=./config/models.yaml

# Email: log (default MVP) | gmail (optional; Railway blocks SMTP)
EMAIL_MODE=log
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
EMAIL_FROM=Talent Scout <you@gmail.com>

# Session limits
SESSION_TTL_HOURS=168
SESSION_MAX_MINUTES=15
SESSION_MAX_QUESTIONS=15

# Optional: store integration tests (skipped when empty)
TEST_DATABASE_URL=
