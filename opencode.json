{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "bash": {
      "*": "deny",
      "go *": "allow",
      "gofmt *": "allow",
      "pnpm *": "allow",
      "git add *": "allow",
      "git commit *": "allow",
      "git status *": "allow",
      "git diff *": "allow",
      "git log *": "allow",
      "git show *": "allow",
      "gh issue view *": "allow",
      "gh issue list *": "allow",
      "gh issue create *": "allow",
      "gh issue comment *": "allow",
      "rg *": "allow",
      "ls *": "allow"
    }
  }
}
